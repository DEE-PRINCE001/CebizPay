    <ProjectReference Include="..\..\src\CebizPay.Application\CebizPay.Application.csproj" />
    <ProjectReference Include="..\..\src\CebizPay.Infrastructure\CebizPay.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\CebizPay.Workers\CebizPay.Workers.csproj" />
  </ItemGroup>

</Project>
