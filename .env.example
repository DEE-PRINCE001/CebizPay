# CebizPay Environment Configuration Example
# Copy this file to .env for local environment configuration (do NOT commit .env)

# Application Environment
ASPNETCORE_ENVIRONMENT=Development
PORT=8080

# PostgreSQL Configuration
POSTGRES_DB=cebizpay
POSTGRES_USER=cebizpay
POSTGRES_PASSWORD=your_secure_postgres_password_here
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=cebizpay;Username=cebizpay;Password=your_secure_postgres_password_here

# Redis Configuration
ConnectionStrings__Redis=localhost:6379
Redis__ConnectionString=localhost:6379
Redis__InstanceName=CebizPay:

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=cebizpay
RABBITMQ_DEFAULT_PASS=your_secure_rabbitmq_password_here
RabbitMQ__HostName=localhost
RabbitMQ__Port=5672
RabbitMQ__UserName=cebizpay
RabbitMQ__Password=your_secure_rabbitmq_password_here
RabbitMQ__VirtualHost=/
RabbitMQ__ExchangeName=cebizpay.events

# JWT Configuration
# MUST be at least 256 bits (32 characters)
Jwt__Secret=your_at_least_32_character_very_secret_signing_key_here
Jwt__Issuer=CebizPay.Api
Jwt__Audience=CebizPay.Clients
Jwt__ExpirationInMinutes=60

# CORS Configuration (comma-separated origins or config array)
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5000
