# # ==============================================================================
# # CebizPay Environment Configuration Template (.env.example)
# # ==============================================================================
# # Copy this file to .env and provide real credentials for your environment.
# # Never commit actual secret keys or credentials to version control.
# # ==============================================================================

# # ASP.NET Core Runtime Configuration
# ASPNETCORE_ENVIRONMENT=Development
# ASPNETCORE_HTTP_PORTS=8080

# # Database (PostgreSQL)
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=cebizpay;Username=cebizpay;Password=cebizpay_dev

# # Cache & Distributed Lock (Redis)
# Redis__ConnectionString=localhost:6379
# Redis__InstanceName=CebizPay:

# # Message Broker (RabbitMQ)
# RabbitMQ__HostName=localhost
# RabbitMQ__Port=5672
# RabbitMQ__UserName=cebizpay
# RabbitMQ__Password=cebizpay_dev
# RabbitMQ__VirtualHost=/
# RabbitMQ__ExchangeName=cebizpay.events

# # JWT Security Options
# Jwt__Secret=your_jwt_signing_key_at_least_32_characters_long_min_256_bits!
# Jwt__Issuer=CebizPay.Api
# Jwt__Audience=CebizPay.Clients
# Jwt__ExpirationInMinutes=15

# # Initial Super Admin Account Seeding
# SuperAdmin__Enabled=true
# SuperAdmin__Email=superadmin@cebizpay.com
# SuperAdmin__Password=SuperAdminPassword123!
# SuperAdmin__FirstName=Super
# SuperAdmin__LastName=Admin
# SuperAdmin__PhoneNumber=+2348000000000

# # ==============================================================================
# # Payment Providers Configuration
# # ==============================================================================

# # Flutterwave Payment Provider
# # Set Enabled=true when ready to test or deploy Flutterwave integration.
# Payments__Flutterwave__Enabled=false
# Payments__Flutterwave__BaseUrl=https://api.flutterwave.com
# Payments__Flutterwave__SecretKey=
# Payments__Flutterwave__PublicKey=
# Payments__Flutterwave__ClientId=
# Payments__Flutterwave__ClientSecret=
# Payments__Flutterwave__TimeoutSeconds=30
# Payments__Flutterwave__Environment=Sandbox
# Payments__Flutterwave__WebhookSecretHash=

# # Paystack Payment Provider
# # Set Enabled=true when ready to test or deploy Paystack integration.
Payments__Paystack__Enabled=false
Payments__Paystack__BaseUrl=https://api.paystack.co
Payments__Paystack__SecretKey=
Payments__Paystack__PublicKey=
Payments__Paystack__TimeoutSeconds=30
Payments__Paystack__Environment=Sandbox
Payments__Paystack__WebhookSecret=

# # Monnify Payment & BaaS Provider
# # Set Enabled=true when ready to test or deploy Monnify integration.
Payments__Monnify__Enabled=false
Payments__Monnify__BaseUrl=https://api.monnify.com
Payments__Monnify__ApiKey=
Payments__Monnify__SecretKey=
Payments__Monnify__ContractCode=
Payments__Monnify__SourceAccountNumber=
Payments__Monnify__TimeoutSeconds=30
Payments__Monnify__Environment=Sandbox
Payments__Monnify__WebhookSecret=

# # ==============================================================================
# # KYC / KYB Compliance & Verification Providers Configuration
# # ==============================================================================

# # Dojah KYC/KYB Provider (BVN, NIN, CAC, AML)
# Dojah__Enabled=false
# Dojah__BaseUrl=https://api.dojah.io
# Dojah__AppId=
# Dojah__PrivateKey=
# Dojah__WebhookSecret=
# Dojah__TimeoutSeconds=30

# # Smile ID Biometric & Identity Provider (SmartSelfie, Document OCR)
# SmileId__Enabled=false
# SmileId__BaseUrl=https://api.smileidentity.com
# SmileId__PartnerId=
# SmileId__ApiKey=
# SmileId__SidServer=0
# SmileId__WebhookSecret=
# SmileId__TimeoutSeconds=30

# # Ninja KYC/KYB Provider (BVN, NIN, CAC Fallback)
# Ninja__Enabled=false
# Ninja__BaseUrl=https://api.ninjakyc.com
# Ninja__ClientId=
# Ninja__ClientSecret=
# Ninja__WebhookSecret=
# Ninja__TimeoutSeconds=30

# # ==============================================================================
# # Value Added Services (VAS) Providers Configuration
# # ==============================================================================

# # VTUGATE VAS Provider (Airtime, Data, Utility Bills)
# # Set Enabled=true when ready to test or deploy VTUGATE integration.
# VAS__VtuGate__Enabled=false
# VAS__VtuGate__BaseUrl=https://vtugate.com/api
# VAS__VtuGate__ApiKey=
# VAS__VtuGate__TimeoutSeconds=30
# VAS__VtuGate__Environment=Sandbox

# # ==============================================================================
# # Communication Providers Configuration (Email & SMS)
# # ==============================================================================

# # SendGrid Transactional Email Provider
# SendGrid__Enabled=false
# SendGrid__ApiKey=SG.your_sendgrid_api_key_here
# SendGrid__FromEmail=noreply@cebizpay.com
# SendGrid__FromName=CebizPay

# # Twilio SMS Provider
# Twilio__Enabled=false
# Twilio__AccountSid=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio__AuthToken=your_twilio_auth_token_here
# Twilio__FromPhoneNumber=+1234567890
# Twilio__MessagingServiceSid=

# # Firebase Cloud Messaging (FCM Push Notifications)
# Firebase__Enabled=false
# Firebase__ProjectId=your_firebase_project_id
# Firebase__CredentialsJson=your_service_account_json_or_path


